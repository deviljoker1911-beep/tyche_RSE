{
  "title": "Tyche — Simulation Performance",
  "uid": "tyche-simulation-perf",
  "tags": ["tyche", "sim"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-12h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "Simulations / hour",
      "datasource": "Prometheus", "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{"expr":"sum(increase(tyche_simulations_total[1h]))"}]
    },
    { "type": "stat", "title": "Avg paths / sim",
      "datasource": "Prometheus", "gridPos": {"x":6,"y":0,"w":6,"h":4},
      "targets": [{"expr":"avg(tyche_simulation_n_paths)"}]
    },
    { "type": "stat", "title": "Avg duration (s)",
      "datasource": "Prometheus", "gridPos": {"x":12,"y":0,"w":6,"h":4},
      "targets": [{"expr":"avg(rate(tyche_simulation_duration_seconds_sum[5m])) / avg(rate(tyche_simulation_duration_seconds_count[5m]))"}]
    },
    { "type": "stat", "title": "Paths / sec throughput",
      "datasource": "Prometheus", "gridPos": {"x":18,"y":0,"w":6,"h":4},
      "targets": [{"expr":"sum(rate(tyche_simulation_paths_total[5m]))"}]
    },
    { "type": "timeseries", "title": "Simulation duration p50/p95/p99",
      "datasource": "Prometheus", "gridPos": {"x":0,"y":4,"w":24,"h":8},
      "targets": [
        {"expr":"histogram_quantile(0.50, sum by (le) (rate(tyche_simulation_duration_seconds_bucket[5m])))","legendFormat":"p50"},
        {"expr":"histogram_quantile(0.95, sum by (le) (rate(tyche_simulation_duration_seconds_bucket[5m])))","legendFormat":"p95"},
        {"expr":"histogram_quantile(0.99, sum by (le) (rate(tyche_simulation_duration_seconds_bucket[5m])))","legendFormat":"p99"}
      ]
    },
    { "type": "timeseries", "title": "Heap allocated (MB)",
      "datasource": "Prometheus", "gridPos": {"x":0,"y":12,"w":12,"h":7},
      "targets": [{"expr":"process_resident_memory_bytes{tyche_component=\"api\"} / 1024 / 1024","legendFormat":"{{instance}}"}]
    },
    { "type": "timeseries", "title": "CPU per instance",
      "datasource": "Prometheus", "gridPos": {"x":12,"y":12,"w":12,"h":7},
      "targets": [{"expr":"rate(process_cpu_seconds_total{tyche_component=\"api\"}[1m])","legendFormat":"{{instance}}"}]
    }
  ]
}
