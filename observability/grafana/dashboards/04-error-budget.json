{
  "title": "Tyche — Error Budget & SLOs",
  "uid": "tyche-slo-budget",
  "tags": ["tyche", "slo"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    { "type": "stat", "title": "API 30d availability",
      "datasource": "Prometheus", "gridPos": {"x":0,"y":0,"w":8,"h":5},
      "fieldConfig": {"defaults":{"unit":"percentunit","decimals":4,
        "thresholds":{"mode":"absolute","steps":[
          {"color":"red","value":0},{"color":"yellow","value":0.995},{"color":"green","value":0.999}
        ]}}},
      "targets": [{"expr":"1 - (sum(increase(http_requests_total{tyche_component=\"api\",status=~\"5..\"}[30d])) / sum(increase(http_requests_total{tyche_component=\"api\"}[30d])))"}]
    },
    { "type": "stat", "title": "API 30d error-budget burn",
      "datasource": "Prometheus", "gridPos": {"x":8,"y":0,"w":8,"h":5},
      "fieldConfig": {"defaults":{"unit":"percentunit",
        "thresholds":{"mode":"absolute","steps":[
          {"color":"green","value":0},{"color":"yellow","value":0.5},{"color":"red","value":1}
        ]}}},
      "targets": [{"expr":"(sum(increase(http_requests_total{tyche_component=\"api\",status=~\"5..\"}[30d])) / sum(increase(http_requests_total{tyche_component=\"api\"}[30d]))) / 0.001"}]
    },
    { "type": "stat", "title": "Anchor freshness SLO",
      "datasource": "Prometheus", "gridPos": {"x":16,"y":0,"w":8,"h":5},
      "fieldConfig": {"defaults":{"unit":"none",
        "thresholds":{"mode":"absolute","steps":[
          {"color":"green","value":0},{"color":"yellow","value":3600},{"color":"red","value":7200}
        ]}}},
      "targets": [{"expr":"max_over_time((time() - tyche_last_anchor_unix_seconds)[30d:1h])"}]
    },
    { "type": "timeseries", "title": "Daily 5xx rate",
      "datasource": "Prometheus", "gridPos": {"x":0,"y":5,"w":24,"h":7},
      "targets": [{"expr":"sum(rate(http_requests_total{tyche_component=\"api\",status=~\"5..\"}[1h])) / sum(rate(http_requests_total{tyche_component=\"api\"}[1h]))"}]
    }
  ]
}
